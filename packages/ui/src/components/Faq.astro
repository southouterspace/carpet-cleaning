---
/** FAQ list using <details>, so answers are in the HTML and need no JS. */
import type { Faq } from "@carpet/seo"

interface Props {
  faqs: Faq[]
  heading?: string
}
const { faqs, heading = "Frequently asked questions" } = Astro.props
---

{faqs.length > 0 && (
  <section class="section" id="faq" aria-labelledby="faq-h">
    <div class="wrap">
      <h2 id="faq-h">{heading}</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}

<style>
  .faq { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; font-weight: 650; padding: 1rem 0; min-height: 48px; }
  .faq p { color: var(--ink-soft); }
</style>

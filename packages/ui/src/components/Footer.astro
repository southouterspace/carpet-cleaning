---
import { callNumber, formatPhone, type SiteConfig } from "@carpet/seo"

interface Props {
  site: SiteConfig
}
const { site } = Astro.props
const year = new Date().getFullYear()
const phone = callNumber(site)
---

<footer class="ftr">
  <div class="wrap ftr__in">
    <div>
      <p class="ftr__name">{site.name}</p>
      <p class="muted">{site.tagline}</p>
      {phone && <p><a href={`tel:${phone}`}>{formatPhone(phone)}</a></p>}
    </div>
    <nav aria-label="Services">
      <p class="ftr__head">Services</p>
      <ul>
        {site.services.map((s) => (
          <li><a href={`/services/${s.slug}`}>{s.name}</a></li>
        ))}
      </ul>
    </nav>
    <div>
      <p class="ftr__head">Serving</p>
      <p class="muted">{site.serviceArea.towns.join(", ")}, {site.region}</p>
    </div>
  </div>
  <div class="wrap ftr__legal muted">
    <span>© {year} {site.operator?.legalName ?? site.name}</span>
    <a href="/privacy">Privacy</a>
  </div>
</footer>

<style>
  .ftr { background: var(--bg-soft); border-top: 1px solid var(--line); padding: 2.5rem 0 1.5rem; margin-top: 2rem; }
  .ftr__in { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .ftr__name { font-weight: 800; }
  .ftr__head { font-weight: 700; margin-bottom: .25rem; }
  .ftr ul { list-style: none; padding: 0; margin: 0; }
  .ftr li a { display: inline-block; padding: .3rem 0; }
  .ftr__legal { display: flex; gap: 1rem; justify-content: space-between; font-size: .9rem; margin-top: 1.5rem; }
</style>

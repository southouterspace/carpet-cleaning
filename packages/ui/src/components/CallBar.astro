---
/** Sticky quote (and call, when phoneCalls is on) buttons on phones, where most leads start. */
import { callNumber, type SiteConfig } from "@carpet/seo"

interface Props {
  site: SiteConfig
}
const { site } = Astro.props
const phone = callNumber(site)
---

{(phone || site.flags.quoteForm) && (
  <div class="callbar" role="region" aria-label="Contact">
    {phone && <a class="btn" href={`tel:${phone}`}>Call now</a>}
    {site.flags.quoteForm && (
      <a class={phone ? "btn btn--ghost" : "btn"} href="/#quote">Get a free quote</a>
    )}
  </div>
)}

<style>
  .callbar {
    position: fixed; inset: auto 0 0 0; z-index: 5; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr;
    gap: .5rem; padding: .5rem .75rem calc(.5rem + env(safe-area-inset-bottom));
    background: #fff; border-top: 1px solid var(--line);
  }
  .callbar .btn--ghost { background: #fff; }
  :global(body) { padding-bottom: 4.5rem; }
  @media (min-width: 48rem) {
    .callbar { display: none; }
    :global(body) { padding-bottom: 0; }
  }
</style>

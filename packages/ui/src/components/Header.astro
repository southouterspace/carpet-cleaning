---
import { callNumber, formatPhone, type SiteConfig } from "@carpet/seo"

interface Props {
  site: SiteConfig
}
const { site } = Astro.props
const phone = callNumber(site)
---

<header class="hdr">
  <div class="wrap hdr__in">
    <a class="hdr__brand" href="/">{site.name}</a>
    <nav aria-label="Main" class="hdr__nav">
      <a href="/#services">Services</a>
      <a href="/#areas">Areas</a>
      <a href="/#faq">FAQ</a>
    </nav>
    {phone ? (
      <a class="btn hdr__call" href={`tel:${phone}`}>Call {formatPhone(phone)}</a>
    ) : site.flags.quoteForm ? (
      <a class="btn hdr__call" href="/#quote">Free quote</a>
    ) : null}
  </div>
</header>

<style>
  .hdr { border-bottom: 1px solid var(--line); background: #fff; }
  .hdr__in { display: flex; align-items: center; gap: 1rem; min-height: 4rem; }
  .hdr__brand { font-weight: 800; font-size: 1.1rem; color: var(--ink); text-decoration: none; margin-right: auto; }
  .hdr__nav { display: none; gap: 1.25rem; }
  .hdr__nav a { color: var(--ink-soft); text-decoration: none; font-weight: 550; padding: .75rem 0; }
  .hdr__nav a:hover { color: var(--ink); }
  .hdr__call { display: none; min-height: 44px; padding: .5rem 1rem; font-size: 1rem; }
  @media (min-width: 48rem) {
    .hdr__nav, .hdr__call { display: inline-flex; }
  }
</style>

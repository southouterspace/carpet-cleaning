---
import { breadcrumbs, faqPage, pageGraph } from "@carpet/seo"
import Facts from "@carpet/ui/Facts.astro"
import Services from "@carpet/ui/Services.astro"
import Faq from "@carpet/ui/Faq.astro"
import QuoteForm from "@carpet/ui/QuoteForm.astro"
import Page from "../components/Page.astro"
import Hero from "../components/Hero.astro"
import Triage from "../components/Triage.astro"
import Areas from "../components/Areas.astro"
import { site } from "../site.config"

const title = `Electrician in Conroe, TX | Repairs, Panels, Generators | ${site.name}`
const description = `Electricians in Conroe, TX: breakers that keep tripping, dead outlets, panel upgrades, generator hookups, EV chargers, lighting and rewiring. Tell us what's happening.`
const jsonld = pageGraph(
  site,
  { path: "/", title, description },
  faqPage(site.faqs),
  breadcrumbs(site, [{ name: "Home", path: "/" }])
)
---

<Page site={site} title={title} description={description} path="/" jsonld={jsonld}>
  <Hero
    site={site}
    kicker="Conroe · Shenandoah · Oak Ridge North"
    heading="Electrician in Conroe, TX"
    lead="Tripping breakers, dead outlets and flickering lights, plus panel upgrades, generator hookups and EV chargers. Describe what's happening and a local electrician gets back to you."
  />
  <Triage />
  <QuoteForm site={site} />
  <Services site={site} heading="Electrical services" />
  <Facts site={site} heading="Conroe electrical work at a glance" />
  <Areas site={site} />
  <Faq faqs={site.faqs} heading="Questions about electricians in Conroe" />
</Page>

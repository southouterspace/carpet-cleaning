---
/** Service area in two columns: lake communities and nearby towns. */
import type { SiteConfig } from "@carpet/seo"

interface Props {
  site: SiteConfig
}
const { site } = Astro.props
const { towns, zips, neighborhoods } = site.serviceArea
---

<section class="section section--soft" id="areas" aria-labelledby="areas-h">
  <div class="wrap">
    <h2 id="areas-h">Where we clean</h2>
    <div class="ar">
      <div>
        <h3>Montgomery and the lake</h3>
        <ul>{neighborhoods.map((n) => <li>{n}</li>)}</ul>
      </div>
      <div>
        <h3>Nearby towns</h3>
        <ul>{towns.map((t) => <li>{t}, {site.region}</li>)}</ul>
        <p class="muted">ZIP codes {zips.join(" and ")}, plus surrounding areas.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .ar { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); margin-top: 1rem; }
  .ar ul { margin: 0 0 1rem; padding-left: 1.2rem; columns: 2 10rem; }
  .ar li { padding: .15rem 0; }
</style>

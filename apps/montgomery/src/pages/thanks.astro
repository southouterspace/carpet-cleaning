---
import Page from "../components/Page.astro"
import { site } from "../site.config"
---

<Page site={site} title={`Thanks | ${site.name}`} description="We got your request." path="/thanks" noindex>
  <section class="section">
    <div class="wrap">
      <h1>Request received</h1>
      <p>Thanks for the details. A local cleaner will get back to you with a price, the way you asked to be contacted. You're under no obligation until you agree to a time.</p>
      <p><a href="/">Back to home</a></p>
    </div>
  </section>
</Page>

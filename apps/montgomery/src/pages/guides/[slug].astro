---
import type { GetStaticPaths } from "astro"
import { article, breadcrumbs, faqPage, graph } from "@carpet/seo"
import Prose from "@carpet/ui/Prose.astro"
import Faq from "@carpet/ui/Faq.astro"
import QuoteForm from "@carpet/ui/QuoteForm.astro"
import Page from "../../components/Page.astro"
import Hero from "../../components/Hero.astro"
import { site } from "../../site.config"

export const getStaticPaths = (() =>
  (site.guides ?? []).map((g) => ({ params: { slug: g.slug }, props: { g } }))) satisfies GetStaticPaths

const { g } = Astro.props
const path = `/guides/${g.slug}`
const jsonld = graph(
  article(site, g),
  faqPage(g.faqs ?? []),
  breadcrumbs(site, [
    { name: "Home", path: "/" },
    { name: g.title, path },
  ])
)
const updated = new Date(`${g.updated}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })
---

<Page site={site} title={`${g.title} | ${site.name}`} description={g.summary} path={path} jsonld={jsonld}>
  <Hero site={site} heading={g.title} lead={g.summary} />
  <nav class="wrap crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <span>Guide</span> · Updated <time datetime={g.updated}>{updated}</time></nav>
  <section class="section">
    <div class="wrap">
      <Prose site={site} paragraphs={g.intro} sections={g.sections} />
    </div>
  </section>
  <QuoteForm site={site} />
  <Faq faqs={g.faqs ?? []} heading="Pricing questions" />
</Page>

<style>
  .crumbs { padding-top: 1rem; font-size: .9rem; color: var(--ink-soft); }
</style>

---
import { breadcrumbs, faqPage, pageGraph } from "@carpet/seo"
import Facts from "@carpet/ui/Facts.astro"
import Services from "@carpet/ui/Services.astro"
import Faq from "@carpet/ui/Faq.astro"
import QuoteForm from "@carpet/ui/QuoteForm.astro"
import Page from "../components/Page.astro"
import Hero from "../components/Hero.astro"
import OldAndNew from "../components/OldAndNew.astro"
import Areas from "../components/Areas.astro"
import { site } from "../site.config"
import { photos } from "../photos"

const title = `Carpet Cleaning Tomball TX | ${site.name}`
const description = `Carpet cleaning in Tomball, TX: carpet, pet odor, sofas, rugs, tile and small offices, from Main Street to Northpointe. Free quote with one total price.`
const jsonld = pageGraph(
  site,
  { path: "/", title, description },
  faqPage(site.faqs),
  breadcrumbs(site, [{ name: "Home", path: "/" }])
)
---

<Page site={site} title={title} description={description} path="/" jsonld={jsonld}>
  <Hero
    site={site}
    kicker="Tomball, Texas · 77375 and 77377"
    heading="Carpet cleaning in Tomball"
    lead="For older homes near Main Street, family homes in Northpointe and places on bigger lots out toward Rosehill. Send a few details and get one total price."
    notes={["Free quotes, priced before anyone drives over", "Rugs and older carpet checked first", "Pet odor treated at the pad"]}
  />
  <OldAndNew site={site} photo={photos.homes} />
  <Services site={site} heading="Services" />
  <Facts site={site} />
  <QuoteForm site={site} />
  <Areas site={site} />
  <Faq faqs={site.faqs} heading="Tomball questions" />
</Page>

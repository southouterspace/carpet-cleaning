---
/** Service area: neighborhoods with pages, then nearby towns, in a ruled box. */
import type { SiteConfig } from "@carpet/seo"

interface Props {
  site: SiteConfig
}
const { site } = Astro.props
const { towns, zips, neighborhoods } = site.serviceArea
const pageFor = (name: string) => site.areas?.find((a) => a.name === name)
---

<section class="section section--soft" id="areas" aria-labelledby="areas-h">
  <div class="wrap">
    <h2 id="areas-h">Where we work</h2>
    <div class="wb">
      <ul>{neighborhoods.map((n) => {
        const a = pageFor(n)
        return <li>{a ? <a href={`/areas/${a.slug}`}>{n}</a> : n}</li>
      })}</ul>
      <p>Plus {towns.filter((t) => t !== site.city).join(", ")}. ZIP codes {zips.join(" and ")}.</p>
    </div>
  </div>
</section>

<style>
  .wb { border: 2px solid var(--accent-dark); background: #fffdf8; padding: 1.25rem 1.5rem; margin-top: 1rem; }
  .wb ul { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-wrap: wrap; gap: .25rem 2rem; }
  .wb a { display: inline-block; padding: .4rem 0; font-weight: 700; }
  .wb p { margin: 0; color: var(--ink-soft); }
</style>

---
/** How a job goes, in three steps. Plain HTML, no JS. */
import type { SiteConfig } from "@carpet/seo"
import SitePhoto from "@carpet/ui/SitePhoto.astro"
import { showPhoto, type PhotoSlot } from "@carpet/ui/photo"

interface Props {
  heading?: string
  /** Optional photo to the left of the steps on wide screens. */
  site?: SiteConfig
  photo?: PhotoSlot
}
const { heading = "How it works", site, photo } = Astro.props
const hasPhoto = !!site && showPhoto(site, photo)
const steps = [
  { h: "Send the details", p: "Use the form to tell us about the rooms, stairs and any spots. It takes about a minute." },
  { h: "Get a price", p: "A local cleaner reviews it and replies by text, call or email with a price and open times." },
  { h: "Pick a time", p: "Choose a day that works. Nothing is booked, and you pay nothing, until you say yes." },
]
---

<section class="section section--soft" aria-labelledby="steps-h">
  <div class="wrap">
    <h2 id="steps-h">{heading}</h2>
    <div class:list={{ "st-photo": hasPhoto }}>
      {hasPhoto && <SitePhoto site={site!} photo={photo} sizes="(min-width: 52rem) 20rem, 100vw" />}
      <ol class="st">
        {steps.map((s) => (
          <li>
            <h3>{s.h}</h3>
            <p class="muted">{s.p}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .st { list-style: none; counter-reset: st; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .st li { counter-increment: st; background: #fff; border-radius: var(--radius); padding: 1.25rem; border: 1px solid var(--line); }
  .st li::before { content: counter(st); display: inline-grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--accent); color: #fff; font-weight: 700; margin-bottom: .75rem; }
  .st p { margin: 0; }
  .st-photo { display: grid; gap: 1.5rem; margin-top: 1.5rem; }
  .st-photo .st { margin: 0; align-content: start; }
  @media (min-width: 52rem) { .st-photo { grid-template-columns: 20rem 1fr; } .st-photo .st { grid-template-columns: 1fr; } }
</style>

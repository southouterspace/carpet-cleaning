---
import { breadcrumbs, faqPage, pageGraph } from "@carpet/seo"
import Facts from "@carpet/ui/Facts.astro"
import Services from "@carpet/ui/Services.astro"
import Faq from "@carpet/ui/Faq.astro"
import QuoteForm from "@carpet/ui/QuoteForm.astro"
import Page from "../components/Page.astro"
import Hero from "../components/Hero.astro"
import Areas from "../components/Areas.astro"
import { site } from "../site.config"

const title = `Electrician in The Woodlands, TX | Repairs, Panels, EV Chargers | ${site.name}`
const description = `Electricians in The Woodlands, TX: troubleshooting, tripping breakers, panel upgrades, EV chargers, generators, lighting and pool wiring. Tell us what's happening; a local electrician replies.`
const jsonld = pageGraph(
  site,
  { path: "/", title, description },
  faqPage(site.faqs),
  breadcrumbs(site, [{ name: "Home", path: "/" }])
)
---

<Page site={site} title={title} description={description} path="/" jsonld={jsonld}>
  <Hero
    site={site}
    heading="Electrician in The Woodlands, TX"
    lead="From a dead circuit in a 1980s Panther Creek home to an EV charger in a new Creekside Park garage. Describe the job and a local electrician gets back to you about a time and a price."
    send={["What stopped working, or what you want added", "Which rooms, and whether a breaker tripped", "A photo of the panel with the door open", "The year the house was built"]}
  />
  <Facts site={site} heading="Electrical work in The Woodlands at a glance" />
  <Services site={site} heading="What we do" />
  <QuoteForm site={site} />
  <Areas site={site} />
  <Faq faqs={site.faqs} heading="Woodlands electrician questions" />
</Page>

---
import { tradeOf } from "@carpet/seo"
import Page from "../components/Page.astro"
import { site } from "../site.config"

const trade = tradeOf(site)
---

<Page site={site} title={`Thanks | ${site.name}`} description="We got your request." path="/thanks" noindex>
  <section class="section">
    <div class="wrap" style="max-width:44rem">
      <h1>Request received</h1>
      <p>Thanks for the details. A local electrician will get back to you the way you asked to be contacted, to set up a time and a price. Nothing is booked until you agree.</p>
      {trade.safety && <p><strong>If it's urgent:</strong> {trade.safety}</p>}
      <p><a href="/">Back to home</a></p>
    </div>
  </section>
</Page>

---
import { breadcrumbs, faqPage, pageGraph } from "@carpet/seo"
import Facts from "@carpet/ui/Facts.astro"
import Services from "@carpet/ui/Services.astro"
import Faq from "@carpet/ui/Faq.astro"
import QuoteForm from "@carpet/ui/QuoteForm.astro"
import Page from "../components/Page.astro"
import Hero from "../components/Hero.astro"
import TwoSides from "../components/TwoSides.astro"
import Areas from "../components/Areas.astro"
import { site } from "../site.config"
import { photos } from "../photos"

const title = `Carpet Cleaning Willis TX | ${site.name}`
const description = `Carpet cleaning in Willis, TX: carpet, pet stains and odor, couches, rugs, tile and move-outs, from I-45 to Lake Conroe. Free quote with the full price.`
const jsonld = pageGraph(
  site,
  { path: "/", title, description },
  faqPage(site.faqs),
  breadcrumbs(site, [{ name: "Home", path: "/" }])
)
---

<Page site={site} title={title} description={description} path="/" jsonld={jsonld}>
  <Hero
    site={site}
    heading="Carpet cleaning in Willis, TX"
    lead="New builds near I-45, older homes in town and lake houses on the east side of Lake Conroe. Tell us what needs cleaning and get the full price first."
    notes={["Free online quotes", "Move-out receipts", "Pet odor treated at the pad"]}
  />
  <Facts site={site} />
  <Services site={site} heading="Cleaning services" />
  <QuoteForm site={site} />
  <TwoSides site={site} photo={photos.local} />
  <Areas site={site} />
  <Faq faqs={site.faqs} heading="Willis carpet cleaning questions" />
</Page>

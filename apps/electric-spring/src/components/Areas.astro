---
/** Area pages as a three-column strip of short blurbs, then towns and ZIPs. */
import type { SiteConfig } from "@carpet/seo"

interface Props {
  site: SiteConfig
}
const { site } = Astro.props
---

<section class="section section--soft" id="areas" aria-labelledby="areas-h">
  <div class="wrap">
    <h2 id="areas-h">Neighborhoods in Spring</h2>
    <div class="sp">
      {(site.areas ?? []).map((a) => (
        <div><h3><a href={`/areas/${a.slug}`}>{a.name}</a></h3><p class="muted">{a.answer}</p></div>
      ))}
    </div>
    <p>Also {site.serviceArea.towns.filter((t) => t !== site.city).join(", ")}. ZIP codes {site.serviceArea.zips.join(", ")}.</p>
  </div>
</section>

<style>
  .sp { display: grid; gap: 1.25rem; margin: 1rem 0 1.5rem; }
  .sp h3 a { display: inline-block; padding: .2rem 0; }
  @media (min-width: 50rem) { .sp { grid-template-columns: repeat(3, 1fr); } }
</style>

---
/** Services as a two-column list of rows (Spring's take on the service grid). */
import type { SiteConfig } from "@carpet/seo"

interface Props {
  site: SiteConfig
  heading: string
}
const { site, heading } = Astro.props
---

<section class="section section--soft" id="services" aria-labelledby="services-h">
  <div class="wrap">
    <h2 id="services-h">{heading}</h2>
    <ul class="sl">
      {site.services.map((s) => (
        <li>
          <a href={`/services/${s.slug}`}>{s.name}</a>
          <span>{s.summary}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .sl { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; gap: 0 2.5rem; }
  .sl li { padding: 1rem 0; border-bottom: 1px solid var(--line); display: grid; gap: .2rem; }
  .sl a { font-weight: 800; font-size: 1.1rem; text-decoration: none; padding: .2rem 0; }
  .sl a:hover { text-decoration: underline; }
  .sl span { color: var(--ink-soft); }
  @media (min-width: 46rem) { .sl { grid-template-columns: 1fr 1fr; } }
</style>

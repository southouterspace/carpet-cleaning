---
/** Service area as cards for neighborhoods with pages, then a line of towns and ZIPs. */
import type { SiteConfig } from "@carpet/seo"

interface Props {
  site: SiteConfig
}
const { site } = Astro.props
const { towns, zips } = site.serviceArea
---

<section class="section" id="areas" aria-labelledby="areas-h">
  <div class="wrap">
    <h2 id="areas-h">Neighborhoods in Spring</h2>
    <div class="grid">
      {(site.areas ?? []).map((a) => (
        <article class="card">
          <h3><a href={`/areas/${a.slug}`}>{a.name}</a></h3>
          <p class="muted">{a.summary}</p>
        </article>
      ))}
    </div>
    <p class="ar-more">Also Klein, {towns.filter((t) => t !== site.city && t !== "Klein").join(", ")}. ZIP codes {zips.join(", ")}.</p>
  </div>
</section>

<style>
  .ar-more { margin-top: 1.25rem; color: var(--ink-soft); }
</style>

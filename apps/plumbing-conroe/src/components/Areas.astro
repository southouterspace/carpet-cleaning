---
/** Service area as cards for neighborhoods with pages, then a line of towns and ZIPs. */
import type { SiteConfig } from "@carpet/seo"

interface Props {
  site: SiteConfig
}
const { site } = Astro.props
---

<section class="section section--soft" id="areas" aria-labelledby="areas-h">
  <div class="wrap">
    <h2 id="areas-h">Where we work around Conroe</h2>
    <div class="grid">
      {(site.areas ?? []).map((a) => (
        <article class="card"><h3><a href={`/areas/${a.slug}`}>{a.name}</a></h3><p class="muted">{a.summary}</p></article>
      ))}
    </div>
    <p class="ar__towns"><strong>Also:</strong> {site.serviceArea.towns.filter((t) => t !== site.city).join(", ")}. <strong>ZIPs:</strong> {site.serviceArea.zips.join(", ")}</p>
  </div>
</section>

<style>
  .ar__towns { margin: 1.5rem 0 0; color: var(--ink-soft); }
</style>

---
import { breadcrumbs, faqPage, pageGraph } from "@carpet/seo"
import Facts from "@carpet/ui/Facts.astro"
import Services from "@carpet/ui/Services.astro"
import Faq from "@carpet/ui/Faq.astro"
import QuoteForm from "@carpet/ui/QuoteForm.astro"
import Page from "../components/Page.astro"
import Hero from "../components/Hero.astro"
import LakeTown from "../components/LakeTown.astro"
import Areas from "../components/Areas.astro"
import { site } from "../site.config"

const title = `Plumber in Montgomery, TX | Lake Conroe Homes | ${site.name}`
const description = `Plumbers for Montgomery, TX and the west side of Lake Conroe: leaks, water heaters, drains, grinder pumps, outdoor kitchens and emergencies. Tell us what's wrong; a local plumber replies.`
const jsonld = pageGraph(
  site,
  { path: "/", title, description },
  faqPage(site.faqs),
  breadcrumbs(site, [{ name: "Home", path: "/" }])
)
---

<Page site={site} title={title} description={description} path="/" jsonld={jsonld}>
  <Hero
    site={site}
    heading="Plumber in Montgomery, TX"
    lead="For lake homes in Walden, Bentwater and April Sound, the historic town and acreage around it. Tell us what's happening and a local plumber gets back to you about a time and a price."
  />
  <LakeTown />
  <QuoteForm site={site} />
  <Services site={site} heading="Plumbing services" />
  <Facts site={site} heading="Montgomery plumbing at a glance" />
  <Areas site={site} />
  <Faq faqs={site.faqs} heading="Montgomery plumbing questions" />
</Page>

---
/** Villages as rounded chips, then the rest of the service area. */
import type { SiteConfig } from "@carpet/seo"

interface Props {
  site: SiteConfig
}
const { site } = Astro.props
---

<section class="section section--soft" id="areas" aria-labelledby="areas-h">
  <div class="wrap">
    <h2 id="areas-h">Villages and nearby towns</h2>
    <ul class="chips">
      {(site.areas ?? []).map((a) => <li><a href={`/areas/${a.slug}`}>{a.name}</a></li>)}
    </ul>
    <p class="muted">Plus every other village in The Woodlands, and {site.serviceArea.towns.filter((t) => t !== site.city).join(", ")}. ZIP codes {site.serviceArea.zips.join(", ")}.</p>
  </div>
</section>

<style>
  .chips { list-style: none; padding: 0; margin: 1rem 0; display: flex; flex-wrap: wrap; gap: .6rem; }
  .chips a { display: inline-block; padding: .6rem 1.1rem; border-radius: 999px; background: #fff; border: 1px solid var(--line); font-weight: 650; text-decoration: none; }
  .chips a:hover { border-color: var(--accent); }
</style>

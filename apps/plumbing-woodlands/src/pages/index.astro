---
import { breadcrumbs, faqPage, pageGraph } from "@carpet/seo"
import Facts from "@carpet/ui/Facts.astro"
import Faq from "@carpet/ui/Faq.astro"
import QuoteForm from "@carpet/ui/QuoteForm.astro"
import Page from "../components/Page.astro"
import Hero from "../components/Hero.astro"
import ServiceRows from "../components/ServiceRows.astro"
import Areas from "../components/Areas.astro"
import { site } from "../site.config"

const title = `Plumber in The Woodlands, TX | Slab Leaks, Water Heaters | ${site.name}`
const description = `Plumbing in The Woodlands, TX: slab leaks, attic water heaters and tankless, polybutylene repipes, drains, sewer lines and gas lines. Tell us what's wrong; a local plumber replies.`
const jsonld = pageGraph(
  site,
  { path: "/", title, description },
  faqPage(site.faqs),
  breadcrumbs(site, [{ name: "Home", path: "/" }])
)
const villages = [
  { name: "Grogan's Mill", built: "1970s on", href: "/areas/grogans-mill" },
  { name: "Panther Creek", built: "late 1970s on" },
  { name: "Cochran's Crossing", built: "1980s on", href: "/areas/cochrans-crossing" },
  { name: "Alden Bridge", built: "1990s on", href: "/areas/alden-bridge" },
  { name: "Creekside Park", built: "late 2000s on", href: "/areas/creekside-park" },
]
---

<Page site={site} title={title} description={description} path="/" jsonld={jsonld}>
  <Hero
    site={site}
    heading="Plumbers for The Woodlands, TX"
    lead="Slab leaks, attic water heaters, polybutylene and the roots of fifty-year-old pines. Tell us what's happening and a local plumber gets back to you about a time and a price."
    villages={villages}
  />
  <Facts site={site} heading="Plumbing in The Woodlands at a glance" />
  <ServiceRows site={site} heading="What we fix" />
  <QuoteForm site={site} />
  <Faq faqs={site.faqs} heading="Woodlands plumbing questions" />
  <Areas site={site} />
</Page>

---
/** Area links inline in a sentence-style block, then towns and ZIPs. */
import type { SiteConfig } from "@carpet/seo"

interface Props {
  site: SiteConfig
}
const { site } = Astro.props
---

<section class="section section--soft" id="areas" aria-labelledby="areas-h">
  <div class="wrap">
    <h2 id="areas-h">Garage door service around Conroe</h2>
    <div class="grid">
      {(site.areas ?? []).map((a) => <article class="card"><h3><a href={`/areas/${a.slug}`}>{a.name}</a></h3><p class="muted">{a.summary}</p></article>)}
    </div>
    <p class="ga">Also {site.serviceArea.towns.filter((t) => t !== site.city).join(", ")} · ZIP codes {site.serviceArea.zips.join(", ")}</p>
  </div>
</section>

<style>
  .ga { margin: 1.25rem 0 0; color: var(--ink-soft); }
</style>

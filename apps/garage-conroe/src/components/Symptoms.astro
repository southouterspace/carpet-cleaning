---
/** Symptom → likely cause table, linking to the matching service. */
const rows = [
  { see: "Loud bang, door won't lift", cause: "Broken spring", href: "/services/broken-spring-repair" },
  { see: "Door hanging crooked", cause: "Snapped cable or off track", href: "/services/off-track-cable-repair" },
  { see: "Goes down, then back up", cause: "Safety sensors", href: "/guides/garage-door-wont-close" },
  { see: "Opener hums, nothing moves", cause: "Spring, lock or opener gear", href: "/services/opener-repair" },
  { see: "Grinding or squealing", cause: "Worn rollers or hinges", href: "/services/tune-ups" },
]
---

<section class="section" aria-labelledby="sy-h">
  <div class="wrap">
    <h2 id="sy-h">What you see, and what it usually means</h2>
    <table class="sy">
      <thead><tr><th scope="col">What you see</th><th scope="col">Usual cause</th></tr></thead>
      <tbody>{rows.map((r) => <tr><td>{r.see}</td><td><a href={r.href}>{r.cause}</a></td></tr>)}</tbody>
    </table>
  </div>
</section>

<style>
  .sy { width: 100%; border-collapse: collapse; margin-top: 1rem; }
  .sy th, .sy td { text-align: left; padding: .8rem .75rem; border-bottom: 1px solid var(--line); }
  .sy thead th { background: #2a2e33; color: #fff; }
  .sy a { font-weight: 700; display: inline-block; padding: .1rem 0; }
</style>

---
/**
 * Conroe garage door hero: graphite band with faint horizontal panel lines
 * like a sectional door, lime signal buttons. Call only with phoneCalls on.
 */
import { callNumber, formatPhone, type SiteConfig } from "@carpet/seo"

interface Props {
  site: SiteConfig
  heading: string
  lead: string
}
const { site, heading, lead } = Astro.props
const phone = callNumber(site)
---

<section class="gd">
  <div class="wrap">
    <h1>{heading}</h1>
    <p class="gd__lead">{lead}</p>
    <div class="gd__cta">
      {phone && <a class="gd__btn" href={`tel:${phone}`}>Call {formatPhone(phone)}</a>}
      {site.flags.quoteForm && <a class:list={["gd__btn", { "gd__btn--line": phone }]} href="#quote">Get the door fixed</a>}
    </div>
  </div>
</section>

<style>
  .gd {
    color: #fff; padding: 3.25rem 0;
    background: repeating-linear-gradient(180deg, #2a2e33 0 5.5rem, #23272b 5.5rem calc(5.5rem + 3px));
  }
  .gd h1 { color: #fff; max-width: 42rem; }
  .gd__lead { font-size: 1.15rem; color: #d9dde1; max-width: 40rem; }
  .gd__cta { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }
  .gd__btn { display: inline-flex; align-items: center; min-height: 48px; padding: .7rem 1.4rem; border-radius: 3px; background: #b6e03a; color: #182000; border: 2px solid #b6e03a; font-weight: 800; text-decoration: none; }
  .gd__btn:hover, .gd__btn:focus-visible { background: #cfee77; }
  .gd__btn--line { background: transparent; color: #fff; border-color: #fff; }
  .gd__btn--line:hover, .gd__btn--line:focus-visible { background: rgba(255,255,255,.1); }
  .gd :focus-visible { outline-color: #b6e03a; }
  @media (min-width: 52rem) { .gd { padding: 4.75rem 0; } }
</style>

---
import { breadcrumbs, faqPage, pageGraph } from "@carpet/seo"
import Facts from "@carpet/ui/Facts.astro"
import Services from "@carpet/ui/Services.astro"
import Faq from "@carpet/ui/Faq.astro"
import QuoteForm from "@carpet/ui/QuoteForm.astro"
import Page from "../components/Page.astro"
import Hero from "../components/Hero.astro"
import Acreage from "../components/Acreage.astro"
import Areas from "../components/Areas.astro"
import { site } from "../site.config"
import { photos } from "../photos"

const title = `Carpet Cleaning Magnolia TX | ${site.name}`
const description = `Carpet cleaning in Magnolia, TX for new homes and acreage: carpet, stairs, pet urine, couches, rugs and tile. Get one price before anyone drives out.`
const jsonld = pageGraph(
  site,
  { path: "/", title, description },
  faqPage(site.faqs),
  breadcrumbs(site, [{ name: "Home", path: "/" }])
)
---

<Page site={site} title={title} description={description} path="/" jsonld={jsonld}>
  <Hero
    site={site}
    heading="Carpet cleaning in Magnolia, TX"
    lead="For new homes in Audubon and Magnolia Ridge and older places on acreage off FM 1488. Tell us about the house and get one price for the whole job."
    steps
  />
  <Services site={site} heading="What we clean" />
  <Acreage site={site} photo={photos.acreage} />
  <QuoteForm site={site} />
  <Facts site={site} />
  <Areas site={site} />
  <Faq faqs={site.faqs} heading="Questions from Magnolia homeowners" />
</Page>

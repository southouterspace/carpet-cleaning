---
/** Service area as chips: communities with pages are links. */
import type { SiteConfig } from "@carpet/seo"

interface Props {
  site: SiteConfig
}
const { site } = Astro.props
const { towns, zips, neighborhoods } = site.serviceArea
const pageFor = (name: string) => site.areas?.find((a) => a.name === name)
---

<section class="section section--soft" id="areas" aria-labelledby="areas-h">
  <div class="wrap">
    <h2 id="areas-h">Around Magnolia</h2>
    <ul class="chips">{neighborhoods.map((n) => {
      const a = pageFor(n)
      return <li>{a ? <a href={`/areas/${a.slug}`}>{n}</a> : <span>{n}</span>}</li>
    })}</ul>
    <p class="muted">Also nearby {towns.filter((t) => t !== site.city).join(", ")}. ZIP codes {zips.join(" and ")}, including homes on the county roads off FM 1488 and FM 1774.</p>
  </div>
</section>

<style>
  .chips { list-style: none; padding: 0; margin: 1.25rem 0; display: flex; flex-wrap: wrap; gap: .6rem; }
  .chips a, .chips span { display: inline-flex; align-items: center; min-height: 44px; padding: .4rem 1rem; border-radius: 999px; background: #fff; border: 1px solid var(--line); }
  .chips a { font-weight: 650; text-decoration: none; }
  .chips a:hover { border-color: var(--accent); }
</style>

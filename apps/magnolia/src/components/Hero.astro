---
/**
 * Magnolia hero: text on the left, a "how a quote works" panel on the right
 * on wide screens. Phone buttons appear only when the phoneCalls flag is on.
 */
import { callNumber, formatPhone, type SiteConfig } from "@carpet/seo"

interface Props {
  site: SiteConfig
  heading: string
  lead: string
  /** Show the three-step panel (home page only). */
  steps?: boolean
}
const { site, heading, lead, steps = false } = Astro.props
const phone = callNumber(site)
---

<section class="gh">
  <div class:list={["wrap", { gh__in: steps }]}>
    <div>
      <h1>{heading}</h1>
      <p class="gh__lead">{lead}</p>
      <div class="gh__cta">
        {site.flags.quoteForm && <a class="btn" href="#quote">Get my price</a>}
        {phone && <a class="btn btn--ghost" href={`tel:${phone}`}>Call {formatPhone(phone)}</a>}
      </div>
    </div>
    {steps && (
      <ol class="gh__steps" aria-label="How a quote works">
        <li><strong>Tell us about the house.</strong> Rooms, stairs, spots and pets, in about a minute.</li>
        <li><strong>Get one price.</strong> A local cleaner replies the way you asked, with a total and open days.</li>
        <li><strong>Pick a day, or don't.</strong> Nothing is booked until you say yes.</li>
      </ol>
    )}
  </div>
</section>

<style>
  .gh { padding: 3rem 0; background: var(--bg-soft); border-bottom: 1px solid var(--line); }
  .gh__lead { font-size: 1.15rem; color: var(--ink-soft); max-width: 36rem; }
  .gh__cta { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }
  .gh__in { display: grid; gap: 2rem; align-items: center; }
  .gh__steps { margin: 0; padding: 1.5rem 1.5rem 1.5rem 3rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); display: grid; gap: 1rem; }
  .gh__steps li::marker { color: var(--accent); font-weight: 800; }
  .gh__steps strong { display: block; color: var(--accent-dark); }
  @media (min-width: 52rem) { .gh__in { grid-template-columns: 1.2fr 1fr; } .gh { padding: 4.5rem 0; } }
</style>

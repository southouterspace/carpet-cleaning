---
/** Service area as a compact table: area, what's typical there, and a link. */
import type { SiteConfig } from "@carpet/seo"

interface Props {
  site: SiteConfig
}
const { site } = Astro.props
---

<section class="section" id="areas" aria-labelledby="areas-h">
  <div class="wrap">
    <h2 id="areas-h">Around Spring</h2>
    <ul class="sa">
      {(site.areas ?? []).map((a) => (
        <li><a href={`/areas/${a.slug}`}>{a.name}</a><span>{a.summary}</span></li>
      ))}
    </ul>
    <p class="muted">Also {site.serviceArea.towns.filter((t) => t !== site.city && t !== "Klein").join(", ")}. ZIP codes {site.serviceArea.zips.join(", ")}.</p>
  </div>
</section>

<style>
  .sa { list-style: none; padding: 0; margin: 1rem 0; }
  .sa li { display: grid; gap: .2rem; padding: .85rem 0; border-top: 1px solid var(--line); }
  .sa a { font-weight: 800; display: inline-block; padding: .2rem 0; }
  .sa span { color: var(--ink-soft); }
  @media (min-width: 48rem) { .sa li { grid-template-columns: 14rem 1fr; gap: 1.5rem; } }
</style>

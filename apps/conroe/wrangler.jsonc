{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "carpet-cleaning-conroe",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only /api/* reaches the Worker; every page is served straight from the edge cache.
    "run_worker_first": ["/api/*"]
  },
  // Quote form posts go to the shared lead Worker through a service binding.
  "services": [{ "binding": "LEADS", "service": "carpet-cleaning-leads" }],
  // Served on workers.dev until the site gets its own domain:
  // https://carpet-cleaning-conroe.southouterspace.workers.dev
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}

---
import Layout from "@carpet/ui/Layout.astro"
import { formatPhone } from "@carpet/seo"
import { site } from "../site.config"
---

<Layout site={site} title={`Thanks | ${site.name}`} description="We got your request." path="/thanks" noindex>
  <section class="section">
    <div class="wrap">
      <h1>Thanks, we got your request</h1>
      <p>We'll call or text you back shortly. Need us sooner? Call <a href={`tel:${site.phone}`}>{formatPhone(site.phone)}</a>.</p>
      <p><a href="/">Back to home</a></p>
    </div>
  </section>
</Layout>

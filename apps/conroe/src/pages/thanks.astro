---
import Layout from "@carpet/ui/Layout.astro"
import { site } from "../site.config"
---

<Layout site={site} title={`Thanks | ${site.name}`} description="We got your request." path="/thanks" noindex>
  <section class="section">
    <div class="wrap">
      <h1>Thanks, we got your request</h1>
      <p>A local carpet cleaner will call or text you shortly with a price. Nothing is booked until you say yes.</p>
      <p><a href="/">Back to home</a></p>
    </div>
  </section>
</Layout>

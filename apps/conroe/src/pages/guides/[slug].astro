---
import type { GetStaticPaths } from "astro"
import { answerOf, article, breadcrumbs, faqPage, howTos, pageGraph, updatedOf } from "@carpet/seo"
import Updated from "@carpet/ui/Updated.astro"
import Layout from "@carpet/ui/Layout.astro"
import Hero from "@carpet/ui/Hero.astro"
import Prose from "@carpet/ui/Prose.astro"
import Faq from "@carpet/ui/Faq.astro"
import QuoteForm from "@carpet/ui/QuoteForm.astro"
import PriceFactors from "../../components/PriceFactors.astro"
import { site } from "../../site.config"

export const getStaticPaths = (() =>
  (site.guides ?? []).map((g) => ({ params: { slug: g.slug }, props: { g } }))) satisfies GetStaticPaths

const { g } = Astro.props
const path = `/guides/${g.slug}`
const answer = answerOf(site, g)
const updated = updatedOf(site, g)
const jsonld = pageGraph(
  site,
  { path, title: g.title, description: g.summary, updated, answer },
  howTos(site, path, g.sections),
  article(site, g),
  faqPage(g.faqs ?? []),
  breadcrumbs(site, [
    { name: "Home", path: "/" },
    { name: g.title, path },
  ])
)
---

<Layout site={site} title={`${g.title} | ${site.name}`} description={g.summary} path={path} jsonld={jsonld}>
  <nav class="wrap crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span>Guide</span></nav>
  <Hero site={site} heading={g.title} lead={answer ?? g.summary} />
  <section class="section">
    <div class="wrap">
      <Updated date={updated} label="Last reviewed" />
      <Prose site={site} paragraphs={g.intro} sections={g.sections} />
    </div>
  </section>
  <PriceFactors guideLink={false} />
  <QuoteForm site={site} />
  <Faq faqs={g.faqs ?? []} heading="More cost questions" />
</Layout>

<style>
  .crumbs { padding-top: 1rem; font-size: .9rem; color: var(--ink-soft); }
</style>

---
import { breadcrumbs, faqPage, pageGraph } from "@carpet/seo"
import Facts from "@carpet/ui/Facts.astro"
import Services from "@carpet/ui/Services.astro"
import Faq from "@carpet/ui/Faq.astro"
import QuoteForm from "@carpet/ui/QuoteForm.astro"
import Page from "../components/Page.astro"
import Hero from "../components/Hero.astro"
import Areas from "../components/Areas.astro"
import { site } from "../site.config"

const title = `Plumber in Willis, TX | Water Heaters, Leaks, Drains | ${site.name}`
const description = `Plumbing repair in Willis, TX: water heaters, leaks, clogged drains, septic lines and new-build fixes, from downtown to Lake Conroe. Tell us what's wrong; a local plumber replies.`
const jsonld = pageGraph(
  site,
  { path: "/", title, description },
  faqPage(site.faqs),
  breadcrumbs(site, [{ name: "Home", path: "/" }])
)
---

<Page site={site} title={title} description={description} path="/" jsonld={jsonld}>
  <Hero
    site={site}
    panel
    heading="Plumber in Willis, TX"
    lead="Water heaters, leaks, clogs and septic lines, for older homes in town, new builds off I-45 and lake houses on the east side. Send three things and a local plumber gets back to you."
  />
  <QuoteForm site={site} />
  <Services site={site} heading="What we fix in Willis" />
  <Areas site={site} />
  <Faq faqs={site.faqs} heading="Willis plumbing questions" />
  <Facts site={site} heading="Willis plumbing at a glance" />
</Page>

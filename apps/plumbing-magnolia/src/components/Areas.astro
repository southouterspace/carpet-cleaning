---
/** Area links as small cards, then nearby towns. */
import type { SiteConfig } from "@carpet/seo"

interface Props {
  site: SiteConfig
}
const { site } = Astro.props
---

<section class="section" id="areas" aria-labelledby="areas-h">
  <div class="wrap">
    <h2 id="areas-h">Around Magnolia</h2>
    <div class="grid">
      {(site.areas ?? []).map((a) => <article class="card"><h3><a href={`/areas/${a.slug}`}>{a.name}</a></h3><p class="muted">{a.summary}</p></article>)}
    </div>
    <p class="mt">Plus {site.serviceArea.towns.filter((t) => t !== site.city).join(", ")}, and acreage across ZIP codes {site.serviceArea.zips.join(" and ")}.</p>
  </div>
</section>

<style>
  .mt { margin-top: 1.25rem; }
</style>
